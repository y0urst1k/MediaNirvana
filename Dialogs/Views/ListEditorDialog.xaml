<Window x:Class="MediaTracker.Views.ListEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="List Editor" Height="350" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
	<StackPanel Margin="20">
		<TextBlock Text="Manage List" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

		<Label Content="List Name" FontWeight="SemiBold"/>
		<TextBox x:Name="NameInput" Padding="5" Margin="0,0,0,10"/>

		<Label Content="Description" FontWeight="SemiBold"/>
		<TextBox x:Name="DescInput" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="5" Margin="0,0,0,10"/>

		<Label Content="List Type" FontWeight="SemiBold"/>
		<ComboBox x:Name="TypeInput" Padding="5" Margin="0,0,0,20" SelectedIndex="0">
			<ComboBoxItem Content="Custom"/>
			<ComboBoxItem Content="Watchlist"/>
			<ComboBoxItem Content="Favorites"/>
		</ComboBox>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="Cancel" IsCancel="True" Padding="15,6" Margin="0,0,10,0" Click="Cancel_Click"/>
			<Button Content="Save" IsDefault="True" Padding="15,6" Background="Black" Foreground="White" Click="Save_Click"/>
		</StackPanel>
	</StackPanel>
</Window>