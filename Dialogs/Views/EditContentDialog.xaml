<UserControl x:Class="Dialogs.Views.EditContentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helper="clr-namespace:Infrastructure.AttachedProperties;assembly=Infrastructure"
        mc:Ignorable="d"
        Height="650" Width="500"
        Background="White">

    <UserControl.Resources>
        <!-- Стили для полей (как в AddDialog) -->
		<Style TargetType="Label">
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0,10,0,5"/>
			<Setter Property="Foreground" Value="#374151"/>
		</Style>
		<Style TargetType="TextBox">
			<Setter Property="Padding" Value="8"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
							<ScrollViewer x:Name="PART_ContentHost"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style TargetType="ComboBox">
			<Setter Property="Padding" Value="8"/>
			<Setter Property="Height" Value="35"/>
		</Style>
	</UserControl.Resources>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Header -->
			<RowDefinition Height="*"/>
			<!-- Scrollable Form -->
			<RowDefinition Height="Auto"/>
			<!-- Footer -->
		</Grid.RowDefinitions>

		<TextBlock Text="Edit Content" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
			<StackPanel>

				<!-- Title -->
				<Label Content="Title *"/>
				<TextBox x:Name="TitleInput"/>

				<!-- Original Title -->
				<Label Content="Original Title"/>
				<TextBox x:Name="OriginalTitleInput"/>

				<!-- Row: Type & Status -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="15"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<Label Content="Type *"/>
						<ComboBox x:Name="TypeInput" SelectionChanged="TypeInput_SelectionChanged">
							<ComboBoxItem Content="Movie"/>
							<ComboBoxItem Content="Book"/>
							<ComboBoxItem Content="Show"/>
							<ComboBoxItem Content="Game"/>
							<ComboBoxItem Content="Music"/>
							<ComboBoxItem Content="Other"/>
						</ComboBox>
					</StackPanel>

					<StackPanel Grid.Column="2">
						<Label Content="Status *"/>
						<ComboBox x:Name="StatusInput">
							<ComboBoxItem Content="Planned"/>
							<ComboBoxItem Content="Watching"/>
							<ComboBoxItem Content="Reading"/>
							<ComboBoxItem Content="Completed"/>
							<ComboBoxItem Content="Paused"/>
							<ComboBoxItem Content="Abandoned"/>
						</ComboBox>
					</StackPanel>
				</Grid>

				<!-- Row: Year & Country -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="15"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0">
						<Label Content="Year"/>
						<TextBox x:Name="YearInput" PreviewTextInput="NumberValidationTextBox"/>
					</StackPanel>
					<StackPanel Grid.Column="2">
						<Label Content="Country"/>
						<TextBox x:Name="CountryInput"/>
					</StackPanel>
				</Grid>

				<!-- Conditional: Video Fields -->
				<StackPanel x:Name="VideoFields" Visibility="Visible">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="15"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="15"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0">
							<Label Content="Duration (min)"/>
							<TextBox x:Name="DurationInput" PreviewTextInput="NumberValidationTextBox"/>
						</StackPanel>

						<!-- Show Fields (Nested in grid) -->
						<StackPanel x:Name="ShowSeasonsField" Grid.Column="2" Visibility="Collapsed">
							<Label Content="Seasons"/>
							<TextBox x:Name="SeasonsInput" PreviewTextInput="NumberValidationTextBox"/>
						</StackPanel>

						<StackPanel x:Name="ShowEpisodesField" Grid.Column="4" Visibility="Collapsed">
							<Label Content="Episodes"/>
							<TextBox x:Name="EpisodesInput" PreviewTextInput="NumberValidationTextBox"/>
						</StackPanel>
					</Grid>
				</StackPanel>

				<!-- Official Rating -->
				<Label Content="Official Rating"/>
				<TextBox x:Name="OfficialRatingInput"/>

				<!-- Synopsis -->
				<Label Content="Synopsis"/>
				<TextBox x:Name="SynopsisInput" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

				<!-- Tags -->
				<Label Content="Tags (comma separated)"/>
				<TextBox x:Name="TagsInput" helper:TextBoxHelper.Placeholder="Drama, Action..."/>

				<!-- Notes -->
				<Label Content="Personal Notes"/>
				<TextBox x:Name="NotesInput" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

			</StackPanel>
		</ScrollViewer>

		<!-- Footer Buttons -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="Cancel" IsCancel="True" Padding="16,8" Background="Transparent" BorderThickness="1" BorderBrush="#D1D5DB" Margin="0,0,10,0" Click="Cancel_Click">
				<Button.Resources>
					<Style TargetType="Border">
						<Setter Property="CornerRadius" Value="6"/>
					</Style>
				</Button.Resources>
			</Button>
			<Button Content="Save Changes" IsDefault="True" Padding="16,8" Background="#111827" Foreground="White" Click="Save_Click">
				<Button.Resources>
					<Style TargetType="Border">
						<Setter Property="CornerRadius" Value="6"/>
					</Style>
				</Button.Resources>
			</Button>
		</StackPanel>
	</Grid>
</UserControl>