<UserControl x:Class="Dialogs.Views.EditContentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helper="clr-namespace:Infrastructure.AttachedProperties;assembly=Infrastructure"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             Height="650" Width="500"
             Background="White">

    <UserControl.Resources>
        <!-- Стили для полей (как в AddDialog) -->
		<Style TargetType="Label">
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0,10,0,5"/>
			<Setter Property="Foreground" Value="#374151"/>
		</Style>
		<Style TargetType="TextBox">
			<Setter Property="Padding" Value="8"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
							<ScrollViewer x:Name="PART_ContentHost"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style TargetType="ComboBox">
			<Setter Property="Padding" Value="8"/>
			<Setter Property="Height" Value="35"/>
		</Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Header -->
			<RowDefinition Height="*"/>
			<!-- Scrollable Form -->
			<RowDefinition Height="Auto"/>
			<!-- Footer -->
		</Grid.RowDefinitions>

		<TextBlock Text="Edit Content" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
			<StackPanel>

				<!-- Title -->
				<Label Content="Title *"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

				<!-- Original Title -->
				<Label Content="Original Title"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

				<!-- Row: Type & Status -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="15"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<Label Content="Type *"/>
                        <ComboBox ItemsSource="{Binding TypeOptions}"
                                  SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}">
                        </ComboBox>
					</StackPanel>

					<StackPanel Grid.Column="2">
						<Label Content="Status *"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}">
                        </ComboBox>
					</StackPanel>
				</Grid>

				<!-- Row: Year & Country -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="15"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0">
						<Label Content="Year"/>
                        <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" PreviewTextInput="NumberValidationTextBox"/>
					</StackPanel>
					<StackPanel Grid.Column="2">
						<Label Content="Country"/>
                        <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>
				</Grid>

				<!-- Conditional: Video Fields -->
                <StackPanel x:Name="VideoFields" Visibility="{Binding IsVideoFieldsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="15"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="15"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0">
							<Label Content="Duration (min)"/>
                            <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" PreviewTextInput="NumberValidationTextBox"/>
						</StackPanel>

						<!-- Show Fields (Nested in grid) -->
                        <StackPanel x:Name="ShowSeasonsField" Grid.Column="2" Visibility="{Binding IsShowFieldsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
							<Label Content="Seasons"/>
                            <TextBox Text="{Binding SeasonsCount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" PreviewTextInput="NumberValidationTextBox"/>
						</StackPanel>

                        <StackPanel Grid.Column="4" Visibility="{Binding IsShowFieldsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
							<Label Content="Episodes"/>
                            <TextBox Text="{Binding EpisodesCount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" PreviewTextInput="NumberValidationTextBox"/>
						</StackPanel>
					</Grid>
				</StackPanel>

				<!-- Official Rating -->
				<Label Content="Official Rating"/>
                <TextBox Text="{Binding OfficialRating, UpdateSourceTrigger=PropertyChanged}"/>

				<!-- Synopsis -->
				<Label Content="Synopsis"/>
                <TextBox Text="{Binding Synopsis, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

				<!-- Tags -->
				<Label Content="Tags (comma separated)"/>
                <TextBox Text="{Binding TagsInput, UpdateSourceTrigger=PropertyChanged}" helper:TextBoxHelper.Placeholder="Drama, Action..."/>

				<!-- Notes -->
				<Label Content="Personal Notes"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

			</StackPanel>
		</ScrollViewer>

		<!-- Footer Buttons -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,8" Background="Transparent" BorderThickness="1" BorderBrush="#D1D5DB" Margin="0,0,10,0" Command="{Binding CancelCommand}">
				<Button.Resources>
					<Style TargetType="Border">
						<Setter Property="CornerRadius" Value="6"/>
					</Style>
				</Button.Resources>
			</Button>
            <Button Content="Save Changes" IsDefault="True" Padding="16,8" Background="#111827" Foreground="White" Command="{Binding SaveCommand}">
				<Button.Resources>
					<Style TargetType="Border">
						<Setter Property="CornerRadius" Value="6"/>
					</Style>
				</Button.Resources>
			</Button>
		</StackPanel>
	</Grid>
</UserControl>