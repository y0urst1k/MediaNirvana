<UserControl x:Class="MainComponents.Views.MediaSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:Infrastructure.Converter;assembly=Infrastructure"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="260">

    <UserControl.Resources>
        <helpers:TypeToIconConverter x:Key="TypeIconConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Стиль для навигационных кнопок -->
        <Style x:Key="NavBtnStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <!-- Gray-400 -->
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <!-- Slate-800/Accent -->
                                <Setter Property="Foreground" Value="#60A5FA"/>
                                <!-- Blue-400 -->
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F2937"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#0F172A" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Nav Menu -->
                <RowDefinition Height="Auto"/>
                <!-- Divider -->
                <RowDefinition Height="*"/>
                <!-- Categories -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                <!-- Logo -->
                <Viewbox Width="32" Height="32" Margin="0,0,12,0">
                    <Path Fill="White" Data="M12 2L2 7l10 5 10-5-10-5zm0 9l2.5-1.25L12 8.5l-2.5 1.25L12 11zm0 2.5l-5-2.5-5 2.5L12 22l10-8.5-5-2.5-5 2.5z"/>
                </Viewbox>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MediaNirvana" Foreground="White" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="{Binding Username, StringFormat='Hi, {0}'}" 
                               Foreground="#94A3B8" FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <!-- NAV MENU -->
            <StackPanel Grid.Row="1" Margin="0,0,0,24">
                <RadioButton Content="📚  My Library" GroupName="NavGroup" Style="{StaticResource NavBtnStyle}" 
                             IsChecked="True" 
                             Command="{Binding NavigateCommand}" 
                             CommandParameter="Library" x:Name="LibBtn"/>
                <RadioButton Content="📋  My Lists" GroupName="NavGroup" Style="{StaticResource NavBtnStyle}" 
                            Command="{Binding NavigateCommand}" 
                             CommandParameter="Lists" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- DIVIDER -->
            <StackPanel Grid.Row="2">
                <Border Height="1" Background="#1E293B" Margin="0,0,0,16"/>
                <TextBlock Text="CATEGORIES" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="8,0,0,12"/>
            </StackPanel>

            <!-- CATEGORIES LIST -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,4">
                                <!-- Category Header Button -->
                                <Button Command="{Binding DataContext.CategoryToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Icon + Label -->
                                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                        <TextBlock Text="{Binding Type, Converter={StaticResource TypeIconConv}}" Foreground="#60A5FA" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="#E2E8F0" FontWeight="Medium"/>
                                                    </StackPanel>

                                                    <!-- Count + Arrow -->
                                                    <StackPanel Orientation="Horizontal" Grid.Column="2">
                                                        <Border Background="#1E293B" CornerRadius="10" Padding="6,1" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Count}" Foreground="#60A5FA" FontSize="10"/>
                                                        </Border>
                                                        <!-- Simple arrow logic: V or > -->
                                                        <TextBlock Text="▼" FontSize="8" Foreground="Gray" VerticalAlignment="Center" 
                                                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="▶" FontSize="8" Foreground="Gray" VerticalAlignment="Center" 
                                                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Inner Items List -->
                                <ItemsControl ItemsSource="{Binding TopItems}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ItemClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Margin="12,4,0,0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="1" CornerRadius="6" Padding="10">
                                                            <StackPanel>
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock Text="{Binding Year}" DockPanel.Dock="Right" Foreground="#64748B" FontSize="10"/>
                                                                    <TextBlock Text="{Binding Title}" Foreground="#CBD5E1" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                </DockPanel>
                                                                <!-- Tags -->
                                                                <TextBlock Text="{Binding TagsString}" Foreground="#60A5FA" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Opacity="0.8"/>
                                                            </StackPanel>
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal"/>
                                                                    <VisualState x:Name="MouseOver">
                                                                        <Storyboard>
                                                                            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1E293B" Duration="0:0:0.1"/>
                                                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#60A5FA" Duration="0:0:0.1"/>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- "More..." indicator -->
                                <TextBlock Text="{Binding RemainingCount, StringFormat='+ {0} more...'}" 
                                           Foreground="#64748B" FontSize="10" Margin="16,4,0,8" FontStyle="Italic"
                                           Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>