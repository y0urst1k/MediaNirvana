<UserControl x:Class="MainComponents.Views.MediaDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:Infrastructure.Converter;assembly=Infrastructure"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <helpers:TypeToIconConverter x:Key="TypeIconConv"/>
        <helpers:StatusToBackgroundConverter x:Key="StatusBgConv"/>
        <helpers:StatusToForegroundConverter x:Key="StatusFgConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBooleanConverter x:Key="InvBool"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisConv"/>
        <helpers:NonEmptyCountToVisibilityConverter x:Key="ShowIfNotEmpty"/>

        <!-- Стиль для карточек -->
        <Style x:Key="DetailCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Стиль для лейблов -->
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="0,0,0,5"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F9FAFB">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header Buttons -->
                <RowDefinition Height="Auto"/>
                <!-- Title Card -->
                <RowDefinition Height="*"/>
                <!-- Content Columns -->
            </Grid.RowDefinitions>

            <!-- ROW 0: HEADER BUTTONS -->
            <DockPanel LastChildFill="False" Grid.Row="0" Margin="0,0,0,20">
                <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" Margin="0,0,5,0"/>
                        <TextBlock Text="Back"/>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- View Mode Buttons -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Button Content="🗑 Delete" Command="{Binding DeleteCommand}" Background="Transparent" Foreground="#EF4444" BorderThickness="1" BorderBrush="#EF4444" Padding="15,6" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Edit" Command="{Binding EditCommand}" Background="White" BorderThickness="1" BorderBrush="#D1D5DB" Padding="15,6">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Edit Mode Buttons -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Background="White" BorderThickness="1" BorderBrush="#D1D5DB" Padding="15,6" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Save" Command="{Binding SaveCommand}" Background="#111827" Foreground="White" Padding="15,6">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- ROW 1: TITLE CARD -->
            <Border Grid.Row="1" Style="{StaticResource DetailCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border Grid.Column="0" Width="80" Height="80" Background="#F3F4F6" CornerRadius="12" Margin="0,0,20,0">
                        <TextBlock Text="{Binding CurrentItem.Type, Converter={StaticResource TypeIconConv}}" 
                                   FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentItem.Type}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentItem.Title}" Foreground="Gray" Margin="0,2,0,10" 
                                   Visibility="{Binding CurrentItem.OriginalTitle, Converter={StaticResource StringToVisConv}}"/>

                        <!-- Badges -->
                        <WrapPanel Orientation="Horizontal">
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,5">
                                <TextBlock Text="{Binding CurrentItem.Year, StringFormat='📅 {0}'}" FontSize="12"/>
                            </Border>
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,5" Visibility="{Binding TempItem.Country, Converter={StaticResource StringToVisConv}}">
                                <TextBlock Text="{Binding CurrentItem.Country, StringFormat='🌍 {0}'}" FontSize="12"/>
                            </Border>
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,5" Visibility="{Binding TempItem.DurationMinutes, Converter={StaticResource ShowIfNotEmpty}}">
                                <TextBlock Text="{Binding CurrentItem.DurationMinutes, StringFormat='⏱ {0} min'}" FontSize="12"/>
                            </Border>
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,5" Visibility="{Binding TempItem.OfficialRating, Converter={StaticResource StringToVisConv}}">
                                <TextBlock Text="{Binding CurrentItem.OfficialRating, StringFormat='🔞 {0}'}" FontSize="12"/>
                            </Border>
                        </WrapPanel>

                        <!-- Tags -->
                        <TextBlock Text="{Binding CurrentItem.TagsInput}" Foreground="#2563EB" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 2: COLUMNS -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <!-- Left: Info -->
                    <ColumnDefinition Width="20"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="2*"/>
                    <!-- Right: Tabs -->
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <StackPanel Grid.Column="0">
                    <!-- Synopsis -->
                    <Border Style="{StaticResource DetailCard}">
                        <StackPanel>
                            <TextBlock Text="Description" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding CurrentItem.Synopsis}" TextWrapping="Wrap" Foreground="#4B5563"/>
                        </StackPanel>
                    </Border>

                    <!-- Characteristics -->
                    <Border Style="{StaticResource DetailCard}">
                        <StackPanel>
                            <TextBlock Text="Characteristics" FontWeight="Bold" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Type" Foreground="Gray"/>
                                <TextBlock Text="{Binding CurrentItem.Type}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,5" Visibility="{Binding CurrentItem.SeasonsCount, Converter={StaticResource ShowIfNotEmpty}}">
                                <TextBlock Text="Seasons" Foreground="Gray"/>
                                <TextBlock Text="{Binding CurrentItem.SeasonsCount}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,5" Visibility="{Binding TempItem.EpisodesCount, Converter={StaticResource ShowIfNotEmpty}}">
                                <TextBlock Text="Episodes" Foreground="Gray"/>
                                <TextBlock Text="{Binding CurrentItem.EpisodesCount}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,10"/>
                        </StackPanel>
                    </Border>

                    <!-- Related Items -->
                    <Border Style="{StaticResource DetailCard}" Visibility="{Binding RelatedItems.Count, Converter={StaticResource ShowIfNotEmpty}}">
                        <StackPanel>
                            <TextBlock Text="Related Media" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding RelatedItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9FAFB" CornerRadius="6" Padding="8" Margin="0,0,0,8" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Type}" FontSize="10" Foreground="Gray"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN -->
                <TabControl Grid.Column="2" BorderThickness="0" Background="Transparent">
                    <TabItem Header="My Progress" FontSize="14">
                        <Border Style="{StaticResource DetailCard}" Margin="0,10,0,0">
                            <StackPanel>
                                <Label Content="Status"/>
                                <ComboBox x:Name="StatusCombo" ItemsSource="{Binding StatusValues}"
                                          SelectedItem="{Binding CurrentItem.Status}"
                                          IsEnabled="{Binding IsEditing}"  Margin="0,0,0,15" Padding="6" SelectedIndex="0">
                                </ComboBox>

                                <Label Content="Rating (1-10)"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBox Text="{Binding CurrentItem.PersonalRating, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditing}" Width="60" Padding="5"/>
                                    <TextBlock Text="/ 10" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>

                                <Label Content="Personal Notes"/>
                                <TextBox Text="{Binding CurrentItem.UserNotes}" IsEnabled="{Binding IsEditing}" 
                                         Height="100" TextWrapping="Wrap" AcceptsReturn="True" Padding="5" 
                                         BorderBrush="#E5E7EB" BorderThickness="1"/>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="Inventory" FontSize="14">
                        <Border Style="{StaticResource DetailCard}" Margin="0,10,0,0">
                            <StackPanel>
                                <!-- Toggles -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Physical Copy" FontWeight="Bold"/>
                                        <TextBlock Text="I own a physical copy" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding CurrentItem.HasPhysicalCopy}" IsEnabled="{Binding IsEditing}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                </Grid>

                                <Grid Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Digital Copy" FontWeight="Bold"/>
                                        <TextBlock Text="I own a digital copy" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding CurrentItem.HasDigitalCopy}" IsEnabled="{Binding IsEditing}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                </Grid>

                                <Separator Margin="0,0,0,15"/>

                                <!-- Inventory Fields -->
                                <Label Content="Format"/>
                                <TextBox Text="{Binding CurrentItem.Format}" IsEnabled="{Binding IsEditing}" Padding="5" Margin="0,0,0,15"/>

                                <Label Content="Source"/>
                                <TextBox Text="{Binding CurrentItem.Source}" IsEnabled="{Binding IsEditing}" Padding="5" Margin="0,0,0,15"/>

                                <Label Content="Location"/>
                                <TextBox Text="{Binding CurrentItem.Location}" IsEnabled="{Binding IsEditing}" Padding="5" Margin="0,0,0,15"/>

                                <Label Content="Price"/>
                                <TextBox Text="{Binding CurrentItem.PurchasePrice}" IsEnabled="{Binding IsEditing}" Padding="5"/>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>