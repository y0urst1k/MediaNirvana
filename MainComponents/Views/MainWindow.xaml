<Window x:Class="MainComponents.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainComponents"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:converters="clr-namespace:Infrastructure.Converter;assembly=Infrastructure" xmlns:views="clr-namespace:MainComponents.Views"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        Title="MediaNirvana" Height="700" Width="1200"
        Background="#F3F4F6" WindowStartupLocation="CenterScreen">

	<Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <!-- Стили для кнопок (аналог Tailwind классов) -->
		<Style x:Key="NavButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="#D1D5DB"/>
			<!-- Gray-300 -->
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Foreground" Value="White"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid>
		<!-- ГЛАВНЫЙ КОНТЕЙНЕР (виден, когда залогинен) -->
        <Grid Visibility="{Binding IsMainAppVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="260"/>
				<!-- w-64 Sidebar -->
				<ColumnDefinition Width="*"/>
				<!-- flex-1 Main -->
			</Grid.ColumnDefinitions>

			<!-- === SIDEBAR === -->
			<!-- Grid.Column="0" означает, что он займет левую колонку -->
			<views:MediaSidebar Grid.Column="0" prism:ViewModelLocator.AutoWireViewModel="True"/>

			<!-- === MAIN CONTENT AREA === -->
			<Border Grid.Column="1" Padding="40">
				<Grid>
					<!-- ЭКРАН 1: CONTENT TRACKER (Библиотека) -->
                    <Grid Visibility="{Binding ActiveScreen, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Library}">
						<!-- Теперь вся логика фильтрации и отображения инкапсулирована в ContentTrackerView.Мы просто передаем данные (Items) и слушаем события.-->
						<views:ContentTracker
							prism:ViewModelLocator.AutoWireViewModel="True"
							Margin="0,0,0,20"/>
					</Grid>

                    <Grid x:Name="ListsScreen" Visibility="{Binding ActiveScreen, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Lists}">
                        <views:ListsScreen  prism:ViewModelLocator.AutoWireViewModel="True"/>
					</Grid>

					<!-- ЭКРАН 2: DETAIL VIEW (Детали) -->
                    <Grid Visibility="{Binding ActiveScreen, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Detail}" Background="#F3F4F6">
                        <views:MediaDetail prism:ViewModelLocator.AutoWireViewModel="True"/>
                    </Grid>

					<!-- ЭКРАН 3: LISTS SCREEN (Списки) -->
				</Grid>
			</Border>
		</Grid>

		<!-- ЭКРАН ЛОГИНА -->
		<!-- ZIndex обеспечивает, что он будет поверх всего -->
		<views:LoginScreen
			Visibility="{Binding DataContext.IsLoginVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
			Grid.ColumnSpan="2"
			prism:ViewModelLocator.AutoWireViewModel="True"
		/>
	</Grid>
</Window>