<Application x:Class="MediaTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MediaTracker"
             StartupUri="MainWindow.xaml">
    <!-- ^^^ Вот эта строчка делает то же самое, что .render(<App />) -->

    <Application.Resources>
        <!-- Сюда переводится содержимое файла index.css -->
        <!-- Глобальные стили для всего приложения -->

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Application.Resources>
</Application>