<UserControl x:Class="MainComponents.Views.ContentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Infrastructure.Converter;assembly=Infrastructure"
             x:Name="CardRoot">
    <!-- Даем имя корню для удобства -->

    <UserControl.Resources>
        <helpers:TypeToIconConverter x:Key="TypeIconConv"/>
        <helpers:StatusToBrushConverter x:Key="StatusColorConv"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisConv"/>

        <!-- Стиль для кнопок -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Margin="5">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon: DataContext здесь - это MediaEditModel -->
                <Border Grid.Column="0" Width="36" Height="36" Background="#F3F4F6" CornerRadius="6" VerticalAlignment="Top" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Type, Converter={StaticResource TypeIconConv}}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                </Border>

                <!-- Titles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding OriginalTitle}" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis" 
                               Visibility="{Binding OriginalTitle, Converter={StaticResource StringToVisConv}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Year}" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text=" • " Foreground="Gray" FontSize="12" Margin="4,0"/>
                        <TextBlock Text="{Binding Country}" Foreground="Gray" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions: Биндимся к DependencyProperties самого контрола -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="👁" Style="{StaticResource GhostBtn}" ToolTip="View Detail" 
                            Command="{Binding ViewDetailCommand, ElementName=CardRoot}" 
                            CommandParameter="{Binding}"/>
                    <Button Content="✎" Style="{StaticResource GhostBtn}" ToolTip="Edit" 
                            Command="{Binding EditCommand, ElementName=CardRoot}" 
                            CommandParameter="{Binding}"/>
                    <Button Content="🗑" Style="{StaticResource GhostBtn}" Foreground="#EF4444" ToolTip="Delete" 
                            Command="{Binding DeleteCommand, ElementName=CardRoot}" 
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>

            <!-- CONTENT -->
            <StackPanel Grid.Row="1">
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Background="{Binding Status, Converter={StaticResource StatusColorConv}}" 
                            CornerRadius="10" Padding="8,2" Margin="0,0,5,5">
                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,5,5"
                            Visibility="{Binding OfficialRating, Converter={StaticResource StringToVisConv}}">
                        <TextBlock Text="{Binding OfficialRating}" FontSize="11"/>
                    </Border>
                </WrapPanel>

                <TextBlock Text="{Binding TagsInput}" Foreground="#2563EB" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Synopsis}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Foreground="#374151" FontSize="13" Margin="0,0,0,8"/>
            </StackPanel>

            <!-- FOOTER -->
            <TextBlock Grid.Row="2" Text="{Binding UpdatedDate, StringFormat='Updated: {0}'}" 
                       FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Right" Margin="0,10,0,0"/>
        </Grid>
    </Border>
</UserControl>